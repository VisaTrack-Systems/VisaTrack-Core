# Backend
APP_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/visatrack
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
AUTH_SECRET_KEY=
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_REFRESH_COOKIE_NAME=visatrack_refresh
# Set false only for local HTTP development.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Use an independent random secret; never reuse AUTH_SECRET_KEY.
MFA_ENCRYPTION_KEY=
MFA_REQUIRED_ROLES=super_admin,org_admin
# Enable after privileged users have enrolled or the bootstrap procedure is complete.
MFA_ENFORCEMENT_ENABLED=false
AWS_REGION=us-east-1
S3_BUCKET_NAME=visatrack-docs-prod
AWS_KMS_KEY_ID=arn:aws:kms:REGION:ACCOUNT_ID:key/KEY_ID
# Optional for S3-compatible local dev (e.g. MinIO)
S3_ENDPOINT_URL=
S3_PRESIGN_EXPIRES_SECONDS=900
S3_MAX_UPLOAD_BYTES=26214400
S3_QUARANTINE_PREFIX=quarantine
S3_CLEAN_PREFIX=clean
DOCUMENT_SCANNER_COMMAND=clamscan
DOCUMENT_SCAN_TIMEOUT_SECONDS=120
DOCUMENT_RETENTION_DAYS=2555
AUDIT_ARCHIVE_BUCKET=visatrack-audit-prod
AUDIT_RETENTION_DAYS=2555
# Optional for local AWS-backed development
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@visatrack.ca
RESEND_FROM_NAME=VisaTrack
BUG_REPORT_TO_EMAIL=visatrack.support@gmail.com
# Dedicated key used only to encrypt lawyer-managed LLM API credentials.
AI_PROVIDER_ENCRYPTION_KEY=
# Temporary comma-separated old keys used only during controlled rotation.
AI_PROVIDER_ENCRYPTION_KEY_PREVIOUS=
# Enable only after provider/privacy approval and synthetic-case validation.
AI_ENABLED=false
# Comma-separated organization UUID allowlist; use "*" only after broad approval.
AI_ENABLED_ORGANIZATION_IDS=
# Comma-separated provider:model entries approved by firm policy.
AI_ALLOWED_MODELS=
# Require MFA enrollment before a user can add or replace a provider key.
AI_REQUIRE_MFA_FOR_KEYS=false
# Keep form drafting separately disabled until exact PDF revisions are approved.
AI_FORM_DRAFTS_ENABLED=false
# Comma-separated lowercase SHA-256 hashes of approved blank PDF templates.
AI_APPROVED_FORM_SHA256=
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_DOCUMENT_CHARS=500000
AI_MAX_CONTEXT_CHUNKS=8
AI_MAX_HISTORY_MESSAGES=12
AI_MAX_HISTORY_CHARS=40000
AI_MAX_REQUESTS_PER_HOUR=60
AI_MAX_REINDEX_DOCUMENTS=100
# Stripe-hosted Checkout; use restricted test keys outside production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=cad

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GITHUB_ISSUES_URL=https://github.com/VisaTrack-Systems/VisaTrack-Core/issues/new
